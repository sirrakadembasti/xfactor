# Copy this file to .env locally and configure provider credentials before use.
NODE_ENV=development
# Production TLS terminates at a loopback reverse proxy:
# NODE_ENV=production
# TRUST_PROXY=loopback
# ALLOWED_ORIGINS=https://xfactor.example
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_PROVIDER=google
AI_MODEL=gemini-3.5-flash
ALLOW_MOCK_FALLBACK=false
GOOGLE_API_KEY=replace-with-your-gemini-api-key
