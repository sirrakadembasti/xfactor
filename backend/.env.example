# Copy this file to .env locally. Configure LLM providers in the admin UI.
NODE_ENV=development
# Production TLS terminates at a loopback reverse proxy:
# NODE_ENV=production
# TRUST_PROXY=loopback
# ALLOWED_ORIGINS=https://xfactor.example
# SHUTDOWN_TIMEOUT_MS=3000
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_MOCK_FALLBACK=false
# LLM Yönetimi: ilk açılışta bu kurulum için rastgele anahtar yerel .env içine yazılır.
# Bu şablona ortak bir anahtar eklemeyin.
# LLM_CONFIG_PATH=./data/llm-profiles.json
# Execution Worker Configuration
EXECUTION_WORKER_TOKEN=dev-worker-token-internal
EXECUTION_WORKER_URL=http://127.0.0.1:8099
READINESS_WORKER_TIMEOUT_MS=2000
